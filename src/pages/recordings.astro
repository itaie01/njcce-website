---
import Navigation from "../components/Navigation.astro";
import Layout from "../layouts/Layout.astro";
import Recording from "../components/Recording.svelte";

const recordings = [
  {
    title: "Am Israel Chai",
    src: "https://www.youtube.com/watch?v=2s7yquY1rCY",
  },
  {
    title: "Yom Ze L'Israel",
    src: "https://www.youtube.com/watch?v=UpPHm3zBhdA",
  },
  {
    title: "Shomer Israel",
    src: "https://www.youtube.com/watch?v=BxBLhpDjSOg&pp=0gcJCSgLAYcqIYzv",
  },
  { title: "Get Happy", src: "https://www.youtube.com/watch?v=bABnTh0nWqA" },
];
---

<Layout>
  <Navigation pageTitle="recordings" />
  <div class="flex items-center justify-center">
    <div
      class="container mx-auto py-8 flex flex-row flex-wrap items-start justify-start gap-8 max-sm:px-4"
    >
      {
        recordings.map((recording, index) => (
          <Recording client:load title={recording.title} src={recording.src} />
        ))
      }
    </div>
  </div>
</Layout>
